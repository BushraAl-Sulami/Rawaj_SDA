RAWAJ_ENV=demo
DATABASE_URL=sqlite:///rawaj.db
LANGGRAPH_CHECKPOINT_PATH=rawaj_outreach_checkpoints.sqlite
OPENAI_API_KEY=
# Select a model available to your API account.
OPENAI_MODEL=
OPENAI_GENERATION_MODEL=
OPENAI_DECISION_MODEL=
OPENAI_REVIEW_MODEL=
APIFY_API_TOKEN=
TAVILY_API_KEY=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Rawaj Team
# Alternative: EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PUBLIC_BASE_URL=http://127.0.0.1:8010
ALLOW_LOCAL_BUTTON_DEMO=true
BUTTON_SIGNING_SECRET=
# Keep both secrets stable. Use different random values, at least 32 characters.
DASHBOARD_URL=http://127.0.0.1:8502
RAWAJ_API_URL=http://127.0.0.1:8010
ACCOUNT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
RAWAJ_DEMO_LOGIN=false
PIPELINE_AUTORUN=true
STRATEGY_POLL_SECONDS=30
# Unset defaults: demo=15 seconds; production=3600 seconds
# FOLLOWUP_POLL_SECONDS=15
# Unset defaults: demo=2 minutes; production=10080 minutes (7 days)
# FOLLOW_UP_DELAY_MINUTES=2
# Includes initial outreach: 3 = initial + two reminders
FOLLOW_UP_MAX_ATTEMPTS=3
STRATEGY_HANDOFF_OUTBOX=strategy_handoffs/inbox
LANGSMITH_TRACING=false
# LLM feedback on each working orchestration node when LangSmith tracing is on.
NODE_LLM_JUDGE=true
# Optional judge model; defaults to OPENAI_MODEL.
NODE_JUDGE_MODEL=
# Optional calendar enrichment
RAWAJ_EVENTS_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
